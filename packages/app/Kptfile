apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: app
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: application
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.3.0
      configPath: ./setters.yaml
status:
  conditions:
    - type: Rendered
      status: "True"
      reason: RenderSuccess
  renderStatus:
    mutationSteps:
      - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.3.0
        exitCode: 0
        results:
          - message: set field value to "nginxdemos/nginx-hello"
            severity: info
            resourceRef:
              apiVersion: skaffold/v3alpha1
              kind: Config
              name: data
            field:
              path: build.artifacts[0].image
              currentValue: nginxdemos/nginx-hello
              proposedValue: nginxdemos/nginx-hello
            file:
              path: skaffold.yaml
