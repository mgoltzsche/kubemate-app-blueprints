apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: webapp
  annotations:
    config.kubernetes.io/local-config: "true"
upstream:
  type: git
  git:
    repo: https://github.com/mgoltzsche/kubemate-app-blueprints
    directory: /packages/app
    ref: main
  updateStrategy: resource-merge
upstreamLock:
  type: git
  git:
    repo: https://github.com/mgoltzsche/kubemate-app-blueprints
    directory: /packages/app
    ref: main
    commit: 84a42fe2e5ac8b992e9c2793f49e3c1d4e7af96f
info:
  description: web application
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.3.0
      configPath: ./setters.yaml
